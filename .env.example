# Copie este arquivo para .env (na raiz do repositório) e ajuste os valores.
# O .env NÃO deve ser versionado.

# Banco de dados — PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=abp
POSTGRES_USER=abp
POSTGRES_PASSWORD=troque-esta-senha

# Backend
APP_PORT=3001
# Gere um valor aleatório, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-segredo
