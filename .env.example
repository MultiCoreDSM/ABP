# Modelo de variaveis de ambiente — plataforma ABP MultiCore (OPS-04)
# Copie este arquivo para ".env" na raiz do repositorio e preencha os valores locais.
# NUNCA versione o arquivo ".env" com credenciais reais.

# ===== Banco de dados PostgreSQL 16 =====
# Fora do container (desenvolvimento local/testes), use localhost e a porta mapeada (ex.: 5433).
# Dentro do Docker Compose, o servico "app" usa automaticamente POSTGRES_HOST=database e porta 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=abp_multicore
POSTGRES_USER=abp
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ===== Seguranca e sessao (API-03 / OPS-04) =====
# Obrigatorio. Gere uma chave aleatoria segura com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
# Tempo de expiracao da sessao JWT (padrao: 1h). Exemplos: 30m, 1h, 2h.
JWT_EXPIRES_IN=1h

# ===== Aplicacao e URL publica =====
APP_PORT=3001
# URL publica usada na geracao do QR Code do certificado PDF.
# Deixe vazio em desenvolvimento para usar automaticamente o host da requisicao.
APP_URL=
# Ambiente de execucao: development | test | production
NODE_ENV=development
